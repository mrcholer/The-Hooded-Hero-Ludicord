LUDICORD_DISCORD_CLIENT_ID=
LUDICORD_DISCORD_CLIENT_SECRET=
LUDICORD_SESSION_SECRET=
LUDICORD_DISCORD_PUBLIC_KEY=
# Comma-separated production/tunnel hostnames, without protocol or paths.
# LUDICORD_ALLOWED_HOSTS=hero.example.com
# Optional disconnect grace period, milliseconds (5000–120000; default 25000).
# LUDICORD_RECONNECT_WINDOW_MS=25000
# LUDICORD_DISCORD_BOT_TOKEN=
# Local development only; never enables mock sessions in production.
# LUDICORD_DEV_FAKE_AUTH=true
# LUDICORD_DEV_USER_ID=local-hooded-hero
# LUDICORD_DEV_USERNAME=hooded_hero
# LUDICORD_DEV_DISPLAY_NAME=Local Hero
# LUDICORD_DEV_INSTANCE_ID=local-adventure-party
# LUDICORD_DEV_GUILD_ID=
# LUDICORD_DEV_CHANNEL_ID=
# LUDICORD_DEV_SCOPES=identify guilds rpc.voice.read
